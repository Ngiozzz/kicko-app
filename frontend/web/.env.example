# Copy to .env and fill in once the Supabase project exists (Project Settings → API).
# Used only for client-side auth (sign up / sign in) — never for direct data access.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Kicko backend base URL (see ../../backend). Everything except auth goes through here.
EXPO_PUBLIC_API_URL=http://localhost:4001
