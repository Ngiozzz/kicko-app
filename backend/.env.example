# Copy to .env and fill in once the Supabase project exists (Project Settings → API).
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS entirely — never expose it to any client, never commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=4001

# Comma-separated list of allowed frontend origins, e.g.
# https://kicko.co.ke,https://www.kicko.co.ke
# Leave empty in local dev to allow all origins.
ALLOWED_ORIGINS=

# Resend (transactional email) — see resend.com/api-keys. Leave unset to
# fall back to console-log-only (see src/services/email.service.ts).
RESEND_API_KEY=
EMAIL_FROM="Kicko <no-reply@kicko.co.ke>"

# Africa's Talking (SMS) — see africastalking.com. Use username "sandbox"
# with your sandbox app's API key until a production app is approved.
# Leave unset to fall back to console-log-only (see src/services/sms.service.ts).
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
